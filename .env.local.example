# ============================================================
# Novelty Labels — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# Supabase
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  # Server only. Never expose to client.

# App URL
# Local dev: http://localhost:3000
# Production: https://track.noveltylabels.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (email notifications)
# Get from: resend.com → API Keys
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=orders@noveltylabels.com  # Must be verified in Resend

# WhatsApp — choose ONE of WATI or Twilio
# WATI (simpler, recommended for India)
WATI_API_ENDPOINT=https://live-server-XXXX.wati.io
WATI_API_TOKEN=your-wati-token

# Twilio (alternative)
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Vercel Cron security (generate a random secret, use same in vercel.json)
# openssl rand -hex 32
CRON_SECRET=your-random-secret-here

# Internal WhatsApp number for overdue alerts (with country code, no +)
ADMIN_WHATSAPP_NUMBER=919876543210
